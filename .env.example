# Copy to .env next to where you start uvicorn.

PROJECT_DIR=/path/to/your/repo                       # has src/, config/glaciers.yaml, data/
GLAVITU_DIR=/path/to/scalable_glacier_mapping        # authors' repo; copy your run_clean_inference.py into it
WEIGHTS=/path/to/glavitu_global_weights.h5
RGI_FILE=/path/to/data/reference/rgi7_alaska_targets.gpkg

# Python 3.10 env with TensorFlow < 2.16 (also install earthengine-api there, then both can be the same)
PY_ML=/path/to/venv310/bin/python
PY_FETCH=/path/to/venv310/bin/python

# Earth Engine project used by src/gee/fetch_rasters.py
# use EXPORT EE_PROJECT if you have to if not using dotenv()
EE_PROJECT=your-cloud-project

# DagsHub bucket (the client reads a token; for a headless server set it as an env var - see DagsHub docs)
DAGSHUB_REPO=saeed-taj/glacier_inference_cache
DAGSHUB_USER_TOKEN=

CORS_ORIGINS=http://localhost:5173
